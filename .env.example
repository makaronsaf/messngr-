# ─── REQUIRED ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production

# ─── URLS ─────────────────────────────────────────────────────────────────────
# Production (domain)
API_URL=https://makaronsaff.sbs/api
WEB_URL=https://makaronsaff.sbs
SOCKET_URL=https://makaronsaff.sbs
ALLOWED_ORIGINS=https://makaronsaff.sbs
CERTBOT_EMAIL=admin@makaronsaff.sbs

# Local dev (uncomment to override)
# API_URL=http://localhost:4000
# WEB_URL=http://localhost:3000
# SOCKET_URL=http://localhost:4001
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── OAUTH (Optional - comment out if not using) ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── WEBRTC TURN SERVER ───────────────────────────────────────────────────────
TURN_SERVER_URL=turn:localhost:3478
TURN_SECRET=messngr-turn-secret

# ─── DATABASE (auto-configured in Docker) ─────────────────────────────────────
# DATABASE_URL=postgresql://messngr:messngr_pass@postgres:5432/messngr_db
# REDIS_HOST=redis
# ELASTICSEARCH_URL=http://elasticsearch:9200
