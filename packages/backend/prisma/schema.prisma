generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivacyLevel {
  EVERYONE
  CONTACTS
  NOBODY
}

enum FolderFilterType {
  ALL
  UNREAD
  CHANNELS
  GROUPS
  BOTS
  PERSONAL
  CUSTOM
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  displayName       String
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  avatarUrl         String?
  bio               String?
  status            UserStatus @default(OFFLINE)
  lastSeen          DateTime?
  isVerified        Boolean   @default(false)
  isBot             Boolean   @default(false)
  isAdmin           Boolean   @default(false)
  isPublic          Boolean   @default(true)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?

  // Privacy settings
  lastSeenPrivacy     PrivacyLevel @default(EVERYONE)
  profilePhotoPrivacy PrivacyLevel @default(EVERYONE)
  allowMessagesFrom   PrivacyLevel @default(EVERYONE)

  // Push notification tokens
  fcmToken          String?
  apnsToken         String?

  // E2E encryption keys
  identityPublicKey String?
  signedPreKey      String?
  oneTimePreKeys    String[]

  // OAuth
  googleId          String?   @unique
  githubId          String?   @unique

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  sentMessages      Message[]           @relation("SentMessages")
  chatMembers       ChatMember[]
  sessions          Session[]
  stories           Story[]
  storyViews        StoryView[]
  reactions         MessageReaction[]
  calls             CallParticipant[]
  notifications     Notification[]
  blockedUsers      UserBlock[]         @relation("Blocker")
  blockedByUsers    UserBlock[]         @relation("Blocked")
  contacts          Contact[]           @relation("UserContacts")
  contactOf         Contact[]           @relation("ContactUser")
  bot               Bot?                @relation("BotUser")
  ownedBots         Bot[]               @relation("BotOwner")
  scheduledMessages ScheduledMessage[]
  pollVotes         PollVote[]
  adminLogs         AdminLog[]          @relation("AdminLogs")
  chatFolders       ChatFolder[]

  @@map("users")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DO_NOT_DISTURB
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chat {
  id              String    @id @default(uuid())
  type            ChatType
  name            String?
  description     String?
  avatarUrl       String?
  isPublic        Boolean   @default(false)
  username        String?   @unique
  isSavedMessages Boolean   @default(false)
  inviteToken     String?   @unique

  // Settings
  slowMode    Int?
  isVerified  Boolean   @default(false)

  // E2E - only for private chats
  encryptionEnabled Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  messages           Message[]
  members            ChatMember[]
  calls              Call[]
  pinnedMessages     PinnedMessage[]
  scheduledMessages  ScheduledMessage[]

  @@map("chats")
}

enum ChatType {
  PRIVATE
  GROUP
  CHANNEL
}

model ChatMember {
  id       String          @id @default(uuid())
  chatId   String
  userId   String
  role     ChatMemberRole  @default(MEMBER)

  isMuted         Boolean  @default(false)
  mutedUntil      DateTime?
  isPinned        Boolean  @default(false)

  lastReadMessageId String?
  lastReadAt        DateTime?

  joinedAt DateTime @default(now())
  leftAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_members")
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
  RESTRICTED
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)

  content     String?
  iv          String?

  // Media
  mediaUrl    String?
  mediaType   String?
  mediaSize   Int?
  mediaDuration Int?
  mediaThumbnail String?
  mediaWidth  Int?
  mediaHeight Int?

  waveform    Float[]

  // Forwarded from
  forwardedFromChatId    String?
  forwardedFromMessageId String?
  forwardedFromUserId    String?

  // Reply to
  replyToMessageId String?
  replyToMessage   Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReplies")

  // Self-destruct
  selfDestructAt  DateTime?
  selfDestructAfterRead Boolean @default(false)
  selfDestructSeconds   Int?

  // Scheduled
  scheduledMessageId String?

  // State
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedFor  String[]

  isPinned    Boolean   @default(false)

  sentAt      DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  reactions   MessageReaction[]
  readBy      MessageRead[]
  pinnedIn    PinnedMessage[]
  poll        Poll?

  @@index([chatId, sentAt])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VIDEO_NOTE
  AUDIO
  VOICE
  FILE
  STICKER
  GIF
  LOCATION
  CONTACT
  POLL
  SYSTEM
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model PinnedMessage {
  chatId    String
  messageId String
  pinnedBy  String
  pinnedAt  DateTime @default(now())

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([chatId, messageId])
  @@map("pinned_messages")
}

// ─── POLLS ────────────────────────────────────────────────────────────────────

model Poll {
  id          String    @id @default(uuid())
  messageId   String    @unique
  question    String
  isMultiple  Boolean   @default(false)
  isAnonymous Boolean   @default(true)
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  text   String
  order  Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  pollId   String
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, optionId])
  @@map("poll_votes")
}

// ─── CHAT FOLDERS ─────────────────────────────────────────────────────────────

model ChatFolder {
  id         String           @id @default(uuid())
  userId     String
  name       String
  icon       String?
  order      Int              @default(0)
  filterType FolderFilterType @default(CUSTOM)
  chatIds    String[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_folders")
}

// ─── BOTS ─────────────────────────────────────────────────────────────────────

model Bot {
  id          String    @id @default(uuid())
  userId      String    @unique
  ownerId     String
  token       String    @unique
  webhookUrl  String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User @relation("BotUser",  fields: [userId],  references: [id], onDelete: Cascade)
  owner User @relation("BotOwner", fields: [ownerId], references: [id])

  @@map("bots")
}

// ─── SCHEDULED MESSAGES ───────────────────────────────────────────────────────

model ScheduledMessage {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)
  content     String?
  mediaUrl    String?
  mediaType   String?
  scheduledAt DateTime
  isSent      Boolean     @default(false)
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, isSent])
  @@map("scheduled_messages")
}

// ─── ADMIN ────────────────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogs", fields: [adminId], references: [id])

  @@map("admin_logs")
}

// ─── STORIES ──────────────────────────────────────────────────────────────────

model Story {
  id          String    @id @default(uuid())
  userId      String
  type        StoryType
  mediaUrl    String
  mediaType   String
  duration    Int?
  caption     String?
  isPrivate   Boolean   @default(false)
  allowedUserIds String[]
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@map("stories")
}

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

model StoryView {
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@map("story_views")
}

model Call {
  id        String     @id @default(uuid())
  chatId    String
  type      CallType
  status    CallStatus @default(RINGING)
  startedAt DateTime?
  endedAt   DateTime?
  duration  Int?
  createdAt DateTime   @default(now())

  chat         Chat              @relation(fields: [chatId], references: [id])
  participants CallParticipant[]

  @@map("calls")
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model CallParticipant {
  callId    String
  userId    String
  joinedAt  DateTime?
  leftAt    DateTime?
  isMuted   Boolean  @default(false)
  isVideoOn Boolean  @default(false)

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@map("call_participants")
}

model Contact {
  userId      String
  contactId   String
  nickname    String?
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User @relation("UserContacts", fields: [userId],    references: [id], onDelete: Cascade)
  contact User @relation("ContactUser",  fields: [contactId], references: [id], onDelete: Cascade)

  @@id([userId, contactId])
  @@map("contacts")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  CALL
  MENTION
  REACTION
  SYSTEM
}

model KeyBundle {
  id              String   @id @default(uuid())
  userId          String   @unique
  registrationId  Int
  identityKey     String
  signedPreKey    Json
  oneTimePreKeys  Json[]
  updatedAt       DateTime @updatedAt

  @@map("key_bundles")
}

model E2ESession {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  sessionData String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderId, recipientId])
  @@map("e2e_sessions")
}
